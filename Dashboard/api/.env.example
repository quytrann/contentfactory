# ContentFactory Dashboard API — database connection.
# Copy this file to `.env` (which is gitignored) and fill in the password.
#
# Either set a full DATABASE_URL...
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/contentfactory
#
# ...or set the individual parts (used only if DATABASE_URL is empty):
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=contentfactory

# Where the API listens. The Vite dev server proxies /api to this.
API_HOST=127.0.0.1
API_PORT=4000

# Comma-separated origins allowed by CORS (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Path to claude.exe for headless script generation (the npm-global bin).
CLAUDE_BIN=

# Script-gen (claude -p headless) tuning. Script gen is CHUNKED: a large scene_count
# is split into batches of SCRIPT_GEN_CHUNK_SCENES scenes, one `claude -p` call each
# (each finishes well under the timeout and retries on its own). SCRIPT_GEN_TIMEOUT is
# the PER-BATCH wall-clock ceiling, not the whole job. Defaults shown.
SCRIPT_GEN_TIMEOUT=200
SCRIPT_GEN_CHUNK_SCENES=23
# Pins Sonnet (don't use a slow Opus default). --max-turns 1 = single JSON emission.
# SCRIPT_GEN_MODEL=sonnet
# SCRIPT_GEN_MAX_TURNS=1

# Google OAuth APP credentials are NOT kept in the repo. Put them in an external
# .env OUTSIDE the repo (default: E:\Installed\ContentFactory-secrets\.env) with:
#   GOOGLE_OAUTH_CLIENT_ID=...
#   GOOGLE_OAUTH_CLIENT_SECRET=...
# Optionally override the location here:
# CF_SECRETS_ENV=E:\Installed\ContentFactory-secrets\.env
